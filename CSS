/* style.css */

:root {
    --background: #0b1120;
    --panel: #111827;
    --panel-light: #172033;
    --border: #263247;
    --text: #f1f5f9;
    --muted: #8c9ab0;
    --blue: #3b82f6;
    --blue-dark: #2563eb;
    --green: #22c55e;
    --red: #ef4444;
    --input: #0d1627;
}

* {
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    margin: 0;
    background: var(--background);
    color: var(--text);
    font-family: Arial, Helvetica, sans-serif;
}


/* =========================
   TOP NAVIGATION
========================= */

.topbar {
    min-height: 70px;
    padding: 0 25px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid var(--border);
    background: #0a101d;
    position: sticky;
    top: 0;
    z-index: 100;
}

.logo {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 20px;
    font-weight: bold;
}

.logo-mark {
    width: 34px;
    height: 34px;
    border-radius: 9px;
    background: var(--blue);
    display: grid;
    place-items: center;
}

.main-nav {
    display: flex;
    gap: 25px;
}

.main-nav a {
    color: var(--muted);
    text-decoration: none;
    font-size: 14px;
}

.main-nav a:hover {
    color: white;
}

.header-actions {
    display: flex;
    align-items: center;
    gap: 15px;
}

.market-status {
    font-size: 12px;
    color: var(--muted);
}

.status-dot {
    display: inline-block;
    width: 7px;
    height: 7px;
    background: var(--green);
    border-radius: 50%;
    margin-right: 5px;
}

.icon-button,
.profile-button,
.small-button {
    border: 1px solid var(--border);
    background: var(--panel);
    color: white;
    cursor: pointer;
}

.icon-button {
    width: 36px;
    height: 36px;
    border-radius: 8px;
}

.profile-button {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--blue);
    border: none;
    color: white;
}


/* =========================
   MAIN
========================= */

main {
    max-width: 1700px;
    margin: auto;
    padding: 20px;
}


/* =========================
   MARKET SUMMARY
========================= */

.market-summary {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 15px;
    margin-bottom: 20px;
}

.market-card {
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 20px;
}

.market-card .label {
    display: block;
    color: var(--muted);
    font-size: 12px;
    margin-bottom: 10px;
}

.market-card strong {
    display: block;
    font-size: 22px;
    margin-bottom: 6px;
}

.market-card small {
    color: var(--muted);
}


/* =========================
   WORKSPACE
========================= */

.workspace {
    display: grid;
    grid-template-columns: 250px minmax(400px, 1fr) 310px;
    gap: 15px;
}


/* =========================
   PANELS
========================= */

.watchlist,
.chart-panel,
.order-panel,
.data-panel {
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
}

.panel-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px;
    border-bottom: 1px solid var(--border);
}

.panel-header h2 {
    margin: 0 0 5px;
    font-size: 16px;
}

.panel-header span {
    color: var(--muted);
    font-size: 12px;
}

.small-button {
    width: 30px;
    height: 30px;
    border-radius: 6px;
}


/* =========================
   WATCHLIST
========================= */

.search-box {
    padding: 12px;
}

.search-box input {
    width: 100%;
    padding: 10px;
    border-radius: 7px;
    border: 1px solid var(--border);
    background: var(--input);
    color: white;
    outline: none;
}

.market-list {
    display: flex;
    flex-direction: column;
}

.market-item {
    width: 100%;
    border: none;
    border-bottom: 1px solid var(--border);
    background: transparent;
    color: white;
    padding: 15px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    text-align: left;
    cursor: pointer;
}

.market-item:hover,
.market-item.active {
    background: var(--panel-light);
}

.market-item strong {
    display: block;
    font-size: 13px;
}

.market-item small {
    display: block;
    margin-top: 5px;
    color: var(--muted);
    font-size: 10px;
}


/* =========================
   CHART HEADER
========================= */

.chart-header {
    min-height: 78px;
    padding: 18px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid var(--border);
}

.instrument {
    display: flex;
    align-items: center;
    gap: 12px;
}

.instrument h1 {
    margin: 0 0 5px;
    font-size: 20px;
}

.instrument span {
    color: var(--muted);
    font-size: 11px;
}

.exchange-badge {
    background: #1d4ed8;
    color: white !important;
    padding: 5px 7px;
    border-radius: 5px;
}

.chart-price {
    text-align: right;
}

.chart-price strong {
    display: block;
    font-size: 20px;
}

.chart-price span {
    font-size: 12px;
}


/* =========================
   CHART TOOLBAR
========================= */

.chart-toolbar {
    padding: 10px 15px;
    display: flex;
    justify-content: space-between;
    border-bottom: 1px solid var(--border);
}

.timeframes,
.indicators {
    display: flex;
    gap: 5px;
}

.timeframes button,
.indicators button {
    background: transparent;
    border: 1px solid transparent;
    color: var(--muted);
    padding: 7px 9px;
    border-radius: 5px;
    cursor: pointer;
}

.timeframes button:hover,
.timeframes button.active,
.indicators button:hover {
    background: var(--panel-light);
    color: white;
}


/* =========================
   CHART
========================= */

.chart-container {
    height: 430px;
    position: relative;
    padding: 10px;
    background: #0c1422;
}

#tradingChart {
    width: 100%;
    height: 100%;
}

.chart-label {
    position: absolute;
    right: 20px;
    padding: 4px 7px;
    font-size: 10px;
    border-radius: 4px;
}

.resistance {
    top: 80px;
    background: rgba(239, 68, 68, 0.15);
    color: #f87171;
}

.support {
    bottom: 90px;
    background: rgba(34, 197, 94, 0.15);
    color: #4ade80;
}

.price-line {
    position: absolute;
    right: 10px;
    top: 45%;
    padding: 5px 8px;
    border-radius: 4px;
    background: var(--blue);
    color: white;
    font-size: 10px;
}


/* =========================
   CHART FOOTER
========================= */

.chart-footer {
    display: flex;
    gap: 25px;
    padding: 13px 18px;
    border-top: 1px solid var(--border);
}

.chart-footer span {
    color: var(--muted);
    margin-right: 5px;
    font-size: 11px;
}

.chart-footer strong {
    font-size: 11px;
}


/* =========================
   ORDER PANEL
========================= */

.panel-tabs {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-bottom: 1px solid var(--border);
}

.order-tab {
    padding: 15px;
    background: transparent;
    border: none;
    color: var(--muted);
    cursor: pointer;
}

.order-tab.active {
    color: white;
    border-bottom: 2px solid var(--blue);
}

.order-content {
    padding: 18px;
}

.order-symbol {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 20px;
}

.order-symbol strong {
    display: block;
}

.order-symbol small {
    display: block;
    color: var(--muted);
    margin-top: 4px;
}

.trade-direction {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    margin-bottom: 20px;
}

.sell-button,
.buy-button {
    padding: 13px;
    border-radius: 7px;
    color: white;
    border: none;
    cursor: pointer;
}

.sell-button {
    background: #7f1d1d;
}

.sell-button:hover {
    background: var(--red);
}

.buy-button {
    background: #166534;
}

.buy-button:hover {
    background: var(--green);
}

.sell-button span,
.buy-button span {
    display: block;
    font-size: 11px;
    margin-bottom: 5px;
}

.sell-button strong,
.buy-button strong {
    font-size: 14px;
}


/* =========================
   FORM
========================= */

.form-group {
    margin-bottom: 16px;
}

.form-group label {
    display: block;
    color: var(--muted);
    font-size: 12px;
    margin-bottom: 7px;
}

.form-group input {
    width: 100%;
    padding: 11px;
    background: var(--input);
    border: 1px solid var(--border);
    color: white;
    border-radius: 6px;
    outline: none;
}

.number-control {
    display: flex;
}

.number-control button {
    width: 38px;
    border: 1px solid var(--border);
    background: var(--panel-light);
    color: white;
    cursor: pointer;
}

.number-control input {
    border-radius: 0;
    text-align: center;
}


/* =========================
   RISK SUMMARY
========================= */

.risk-summary {
    border: 1px solid var(--border);
    border-radius: 7px;
    padding: 12px;
    margin: 20px 0;
}

.risk-summary div {
    display: flex;
    justify-content: space-between;
    margin: 8px 0;
}

.risk-summary span {
    color: var(--muted);
    font-size: 11px;
}

.risk-summary strong {
    font-size: 11px;
}


/* =========================
   EXECUTE BUTTON
========================= */

.execute-button {
    width: 100%;
    padding: 13px;
    border: none;
    border-radius: 7px;
    background: var(--blue);
    color: white;
    font-weight: bold;
    cursor: pointer;
}

.execute-button:hover {
    background: var(--blue-dark);
}

.demo-warning {
    color: #fbbf24;
    font-size: 10px;
    text-align: center;
    line-height: 1.5;
}


/* =========================
   LOWER PANELS
========================= */

.bottom-grid {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 15px;
    margin-top: 15px;
}

.table-wrapper {
    overflow-x: auto;
}

table {
    width: 100%;
    border-collapse: collapse;
}

th,
td {
    padding: 14px 18px;
    border-bottom: 1px solid var(--border);
    text-align: left;
    white-space: nowrap;
}

th {
    color: var(--muted);
    font-size: 11px;
    font-weight: normal;
}

td {
    font-size: 12px;
}

.market-information {
    display: grid;
    grid-template-columns: 1fr 1fr;
}

.market-information div {
    padding: 18px;
    border-bottom: 1px solid var(--border);
}

.market-information span {
    display: block;
    color: var(--muted);
    font-size: 11px;
    margin-bottom: 7px;
}

.market-information strong {
    font-size: 13px;
}


/* =========================
   COLORS
========================= */

.positive {
    color: var(--green) !important;
}

.negative {
    color: var(--red) !important;
}


/* =========================
   FOOTER
========================= */

footer {
    text-align: center;
    padding: 30px;
    color: var(--muted);
    font-size: 11px;
}


/* =========================
   RESPONSIVE DESIGN
========================= */

@media (max-width: 1200px) {

    .workspace {
        grid-template-columns: 210px 1fr;
    }

    .order-panel {
        grid-column: 1 / -1;
    }

}


@media (max-width: 850px) {

    .topbar {
        flex-wrap: wrap;
        gap: 12px;
        padding: 15px;
    }

    .main-nav {
        order: 3;
        width: 100%;
        justify-content: center;
    }

    .market-summary {
        grid-template-columns: 1fr 1fr;
    }

    .workspace {
        grid-template-columns: 1fr;
    }

    .watchlist {
        order: 2;
    }

    .chart-panel {
        order: 1;
    }

    .order-panel {
        order: 3;
    }

    .bottom-grid {
        grid-template-columns: 1fr;
    }

}


@media (max-width: 600px) {

    main {
        padding: 10px;
    }

    .market-summary {
        grid-template-columns: 1fr;
    }

    .header-actions .market-status {
        display: none;
    }

    .chart-container {
        height: 350px;
    }

    .chart-footer {
        gap: 10px;
        overflow-x: auto;
    }

    .chart-toolbar {
        overflow-x: auto;
    }

    .instrument h1 {
        font-size: 17px;
    }

}
